# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env (already gitignored).
# On Cloud Run, everything marked SECRET comes from Secret Manager instead.
# ---------------------------------------------------------------------------

# --- Gemini / ADK ---
GOOGLE_API_KEY=your_gemini_api_key          # SECRET
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model ids are env-driven on purpose: Gemini model names get retired.
AGENT_MODEL=gemini-3.6-flash
VISION_MODEL=gemini-3.6-flash

# Transient-failure retry (503 UNAVAILABLE, deadline exceeded)
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY=1.5

# --- Twilio WhatsApp (classic sandbox) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token    # SECRET
# Classic sandbox sender is always this number:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# 1 = reject webhook calls that fail Twilio signature validation. Use 1 in
# production, 0 only while poking the endpoint with synthetic POSTs.
TWILIO_VALIDATE_SIGNATURE=1
# Public base URL of this service (ngrok / Cloud Run). Required for signature
# validation and for the one-time sign-in link.
PUBLIC_BASE_URL=

# --- Reply timing ---
# How long a turn may run before the student is told to send `more`.
# Must stay comfortably under Twilio's webhook timeout.
TWIML_BUDGET_SECONDS=13
# Global cap on simultaneous agent turns in this container.
MAX_CONCURRENT_TURNS=4

# --- Per-student linking ---
# memory = single instance, wiped on every new revision. firestore = durable.
TOKEN_STORE=memory
FIRESTORE_COLLECTION=agent_sessions
# Salt for hashing the sender's phone number into a store key.
# Changing this orphans every stored token.
USER_KEY_PEPPER=change_me                   # SECRET
# One-time sign-in link lifetime, and how long a linked token is kept.
LINK_TTL_SECONDS=600
TOKEN_TTL_SECONDS=2592000

# --- E-learning (Moodle web services) ---
MOODLE_BASE_URL=https://elearning.example.ac.ke
# Optional service token for read-only diagnostics. Students link their own.
MOODLE_TOKEN=                               # SECRET

# --- Browser automation (OPTIONAL, off by default) ---
# 1 registers the Playwright MCP toolset and the screenshot->Gemini vision
# fallback. Left at 0 they are never imported. The e-learning site is always
# reached over its API, never the browser: it allows one login per user.
ENABLE_BROWSER_TOOLS=0
# Only read when the gate above is 1.
PLAYWRIGHT_MCP_URL=
BROWSER_ARTIFACT_DIR=./artifacts
BROWSER_HEADLESS=1
# Semicolon-separated origin allowlist for the browser. Empty = allow all.
BROWSER_ALLOWED_ORIGINS=

# --- Demo target (sandbox site only, used for browser smoke tests) ---
DEMO_SITE_URL=https://www.saucedemo.com
DEMO_USERNAME=standard_user
DEMO_PASSWORD=secret_sauce

# --- Telegram (dormant second adapter; leave empty to keep it off) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
