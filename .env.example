# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env (already gitignored).
# ---------------------------------------------------------------------------

# --- Gemini / ADK ---
GOOGLE_API_KEY=your_gemini_api_key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Models
AGENT_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.5-flash

# --- Twilio WhatsApp (free tier / sandbox) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Sandbox sender is always this number:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set to 1 to reject webhook calls that fail Twilio signature validation
TWILIO_VALIDATE_SIGNATURE=0
# Public base URL of this service (ngrok/Cloud Run). Needed for signature validation.
PUBLIC_BASE_URL=

# --- Browser automation ---
# Where playwright-mcp writes screenshots / snapshots. Must match the agent config.
BROWSER_ARTIFACT_DIR=./artifacts
BROWSER_HEADLESS=1
# Semicolon-separated origin allowlist for the browser. Empty = allow all.
# Recommended for the demo:
# BROWSER_ALLOWED_ORIGINS=https://www.saucedemo.com;https://the-internet.herokuapp.com
BROWSER_ALLOWED_ORIGINS=

# --- Demo target credentials (sandbox site only) ---
DEMO_SITE_URL=https://www.saucedemo.com
DEMO_USERNAME=standard_user
DEMO_PASSWORD=secret_sauce
